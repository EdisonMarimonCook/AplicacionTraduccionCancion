# ======================================
# CONFIGURACIÓN MONGODB
# ======================================
# Si no tienes MongoDB, déjalo así (usa BD mock)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=music_translator
MONGODB_USER=  # Dejar vacío si no tienes usuario/contraseña
MONGODB_PASSWORD=  # Dejar vacío si no tienes contraseña

# ======================================
# SPOTIFY API
# ======================================
SPOTIFY_CLIENT_ID=tu_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_client_secret_aqui

# ======================================
# JWT (Autenticación)
# ======================================
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ======================================
# OPENAI (Para análisis con IA)
# ======================================
OPENAI_API_KEY=sk-...

# ======================================
# ENTORNO
# ======================================
ENVIRONMENT=development
DEBUG=True
USE_MOCK_DB=False  # Cambiar a True si no tienes MongoDB