# ======================================
# 🎵 MUSIC TRANSIATOR - CONFIGURACIÓN
# ======================================
# Este es un archivo de EJEMPLO
# Copiar a .env y rellenar valores reales
# NUNCA commitear .env (solo .env.example)

# ======================================
# 🗄️ MONGODB - BASE DE DATOS
# ======================================
# Si NO tienes MongoDB instalado:
#   → Dejar USE_MOCK_DB=true (abajo)
#   → Esto usa BD simulada (OK para prototipo)
#
# Si SÍ tienes MongoDB:
#   → Rellenar MONGODB_URL
#   → Cambiar USE_MOCK_DB=false

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=music_translator
MONGODB_USER=
MONGODB_PASSWORD=
USE_MOCK_DB=true

# ======================================
# 🎵 SPOTIFY API - Previews + Metadata
# ======================================
# Obtén aquí: https://developer.spotify.com/dashboard
# 1. Crear app
# 2. Copiar Client ID y Client Secret

SPOTIFY_CLIENT_ID=tu_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_client_secret_aqui

# ======================================
# 📝 GENIUS API - Extraer Letras
# ======================================
# Obtén aquí: https://genius.com/api-clients
# 1. Crear cuenta
# 2. Crear aplicación
# 3. En "App Website URL" poner: http://localhost:8000
# 4. Copiar el token

GENIUS_API_TOKEN=tu_genius_token_aqui

# ======================================
# 🔐 JWT - Autenticación (Bearer Token)
# ======================================
# SECRET_KEY: Contraseña para firmar tokens
#   → CAMBIAR EN PRODUCCIÓN (generar con: openssl rand -hex 32)
# ALGORITHM: Algoritmo de firma (no tocar)
# ACCESS_TOKEN_EXPIRE_MINUTES: Duración token login (30 min OK)
# REFRESH_TOKEN_EXPIRE_DAYS: Duración token refresh (7 días OK)

SECRET_KEY=your-super-secret-key-change-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ======================================
# 🤖 IA - ANÁLISIS DE LETRAS
# ======================================
# OPCIÓN 1: MOCK (Actual - para prototipo)
#   → USE_MOCK_IA=true
#   → Sin API keys necesarias
#   → Análisis simulado (funcional)
#   → Perfecto para testing ahora

USE_MOCK_IA=true

# OPCIÓN 2: GEMINI (Google) - ⭐ RECOMENDADO
#   → Cambiar USE_MOCK_IA=false
#   → USE_GEMINI=true
#   → Obtén API key: https://makersuite.google.com/app/apikey
#   → GRATIS (60 requests/min, suficiente para MVP)
#   → IA real, excelente calidad

USE_GEMINI=false
GEMINI_API_KEY=tu_gemini_api_key_aqui

# OPCIÓN 3: OLLAMA (Local, OpenSource)
#   → Cambiar USE_MOCK_IA=false
#   → USE_OLLAMA=true
#   → Descargar desde: https://ollama.ai/
#   → Modelos: llama2, mistral, neural-chat (7B)
#   → GRATIS, offline, sin límites de requests
#   → Requiere ~10GB disco + GPU recomendado

USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# OPCIÓN 4: CLAUDE (Anthropic) - Premium
#   → Cambiar USE_MOCK_IA=false
#   → USE_CLAUDE=true
#   → Obtén API key: https://console.anthropic.com/
#   → PAGO ($3-30/mes dependiendo uso)
#   → Mejor IA del mercado

USE_CLAUDE=false
CLAUDE_API_KEY=tu_claude_api_key_aqui

# ======================================
# 🌐 CORS - Control de Acceso
# ======================================
# URLs permitidas para conectar desde frontend/Android
# En desarrollo: permitir localhost
# En producción: poner solo URL real

FRONTEND_URL=http://localhost:3000
ANDROID_BASE_URL=http://10.0.2.2:8000

# ======================================
# 🔧 ENTORNO - Desarrollo vs Producción
# ======================================
# ENVIRONMENT: development, staging, production
# DEBUG: true (desarrollo), false (producción)
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ======================================
# 📊 CACHÉ - Top 10 Canciones
# ======================================
# CACHE_TTL_MINUTES: Cuánto tiempo guardar top 10 en memoria
# Valores: 60 (1h), 120 (2h), 1440 (24h)

CACHE_TTL_MINUTES=120