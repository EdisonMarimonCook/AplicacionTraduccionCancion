# ======================================
# 🎵 MUSICTRANSIATOR - CONFIGURACIÓN
# ======================================
# Este es un archivo de EJEMPLO
# Copiar a .env y rellenar valores reales
# NUNCA commitear .env (solo .env.example)

# ======================================
# 🗄️ MONGODB - BASE DE DATOS REAL
# ======================================
# Connection string completo (incluyendo usuario:contraseña)
# Formato: mongodb+srv://usuario:contraseña@cluster.mongodb.net/nombreBD
# 
# Ejemplo con tus credenciales:
# MONGODB_URL=mongodb+srv://music_translator_app:TU_PASSWORD@cluster0.mongodb.net/music_translator?retryWrites=true&w=majority
#
# Para DESARROLLO LOCAL (sin MongoDB Atlas):
# MONGODB_URL=mongodb://localhost:27017
#
# IMPORTANTE: Si usas caracteres especiales en la contraseña, encódificar URL
# Ej: @ → %40, ! → %21, etc.

MONGODB_URL=mongodb+srv://music_translator_app:CONTRASEÑA_AQUI@cluster.mongodb.net/music_translator?retryWrites=true&w=majority
MONGODB_DATABASE=music_translator

# Usar MongoDB real (false = MOCK, true = MOCK para desarrollo)
USE_MOCK_DB=false

# ======================================
# 🎵 SPOTIFY API - Previews + Metadata
# ======================================
# Obtén aquí: https://developer.spotify.com/dashboard
# 1. Crear app ("Create an App")
# 2. Aceptar términos
# 3. En "App name" poner: MusicTransIAtor
# 4. Copiar "Client ID" y "Client Secret"
# 5. Settings → Redirect URIs → http://localhost:8000/callback

SPOTIFY_CLIENT_ID=tu_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_client_secret_aqui

# ======================================
# 📝 GENIUS API - Extraer Letras
# ======================================
# Obtén aquí: https://genius.com/api-clients
# 1. Login/Crear cuenta
# 2. Click "Create API Client"
# 3. "App Website URL": http://localhost:8000
# 4. Generar "Access Token"
# 5. Copiar el token completo

GENIUS_ACCESS_TOKEN=tu_genius_token_aqui

# ======================================
# 🔐 JWT - AUTENTICACIÓN (Bearer Token)
# ======================================
# SECRET_KEY: Contraseña para firmar tokens JWT
#   → CAMBIAR EN PRODUCCIÓN
#   → Generar: openssl rand -hex 32
#   → Ejemplo: 3f8d2a9c5e1b7f4a2d8c9e0f1a2b3c4d
# ALGORITHM: HS256 (no cambiar)
# ACCESS_TOKEN_EXPIRE_MINUTES: Duración token login (30 min = 1 trabajo)
# REFRESH_TOKEN_EXPIRE_DAYS: Duración refresh token (7 días = 1 semana)

SECRET_KEY=your-super-secret-key-change-in-production-12345-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ======================================
# 🤖 IA - ANÁLISIS DE LETRAS CON GEMINI
# ======================================
# OPCIÓN SELECCIONADA: Google Gemini (Gratuito, potente)
#
# Obtén: https://makersuite.google.com/app/apikey
# 1. Click "Create API Key"
# 2. Select "Create API key in new project"
# 3. Copiar la key
# 4. Pegar aquí
#
# VENTAJAS:
#   - Gratuito (60 requests/min, suficiente para MVP)
#   - Sin límite de documentos
#   - Multiidioma excelente
#   - Fallback automático a MOCK si falla
#   - NO requiere tarjeta de crédito
#
# LIMITES:
#   - 60 req/min (suficiente)
#   - RPM (requests por minuto) limitado
#   - Después 10/12: considerar upgrade

USE_GEMINI=true
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ======================================
# 🌐 CORS - Control de Acceso
# ======================================
# URLs permitidas para conectar desde frontend/Android
# En desarrollo: permitir localhost + emulador
# En producción: poner solo URLs reales

FRONTEND_URL=http://localhost:3000
ANDROID_EMULATOR_URL=http://10.0.2.2:8000
ANDROID_DEVICE_URL=http://192.168.x.x:8000

# ======================================
# 🔧 ENTORNO - Desarrollo vs Producción
# ======================================
# ENVIRONMENT: development, staging, production
# DEBUG: true (desarrollo), false (producción)
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ======================================
# 📊 CACHÉ - Top 10 Canciones (Opcional)
# ======================================
# CACHE_TTL_MINUTES: Cuánto tiempo guardar top 10 en memoria
# Valores: 60 (1h), 120 (2h), 1440 (24h)
# NOTA: Para MVP, sin Redis, usa memory caché (OK)

CACHE_TTL_MINUTES=120

# ======================================
# ⚙️ CONFIGURACIÓN AVANZADA (NO TOCAR)
# ======================================
# Estos valores son para desarrollo
# NO cambiar sin saber qué haces

API_VERSION=v1
API_PREFIX=/api/v1
MAX_CONTENT_LENGTH=10485760
REQUEST_TIMEOUT=30