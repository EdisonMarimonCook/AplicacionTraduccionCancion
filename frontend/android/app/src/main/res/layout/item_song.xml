<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="16dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardSong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/bg_card"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- ✅ FLASH (ESTO SÍ FUNCIONA) -->
            <View
                android:id="@+id/viewFlashInternal"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/anime_flash"
                android:rotation="20"
                android:alpha="0.5"
                android:elevation="10dp"
                android:visibility="invisible"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <!-- Resto del contenido sin cambios -->
            <ImageView
                android:id="@+id/ivSongCover"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_launcher_foreground"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/tvSongTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Título Canción"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@id/ivSongCover"
                app:layout_constraintTop_toTopOf="@id/ivSongCover"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tvSongArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Artista"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintStart_toStartOf="@id/tvSongTitle"
                app:layout_constraintTop_toBottomOf="@id/tvSongTitle"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvGrammyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆 GRAMMY NOMINEE"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFD700"
                android:background="#000000"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                app:layout_constraintStart_toEndOf="@id/tvSongArtist"
                app:layout_constraintBottom_toBottomOf="@id/tvSongArtist"
                app:layout_constraintTop_toTopOf="@id/tvSongArtist"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>