<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo dorado solido para Grammy (sin animacion, 60fps estables) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="135"
        android:startColor="#FFD700"
        android:centerColor="#FFC107"
        android:endColor="#FFB300"
        android:type="linear" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="#FF8C00" />
</shape>
