<?xml version="1.0" encoding="utf-8"?>
<animation-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:oneshot="false">
    
    <!-- Frame 1: Gradiente normal -->
    <item android:duration="400">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#FFD700"
                android:centerColor="#FFC107"
                android:endColor="#FFB300"
                android:type="linear" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#FF8C00" />
        </shape>
    </item>
    
    <!-- Frame 2: Shimmer medio -->
    <item android:duration="400">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#FFC107"
                android:centerColor="#FFECB3"
                android:endColor="#FFC107"
                android:type="linear" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#FF8C00" />
        </shape>
    </item>
    
    <!-- Frame 3: Shimmer brillante -->
    <item android:duration="400">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#FFB300"
                android:centerColor="#FFFEF5"
                android:endColor="#FFD700"
                android:type="linear" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#FF8C00" />
        </shape>
    </item>
    
    <!-- Frame 4: Shimmer medio -->
    <item android:duration="400">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#FFC107"
                android:centerColor="#FFECB3"
                android:endColor="#FFC107"
                android:type="linear" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#FF8C00" />
        </shape>
    </item>
</animation-list>
