<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.DiccionarioHipHop" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color (El morado que usas) -->
        <item name="colorPrimary">#6200EE</item>
        <item name="colorPrimaryVariant">#3700B3</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Secondary brand color (El verde azulado por defecto) -->
        <item name="colorSecondary">#03DAC6</item>
        <item name="colorSecondaryVariant">#018786</item>
        <item name="colorOnSecondary">@android:color/black</item>

        <!-- Status bar color (La barra de notificaciones) -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Customize your theme here -->
    </style>
</resources>