<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.diccionario_hiphop">

    <!-- PERMISOS -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DiccionarioHipHop"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true">
        
        <!-- ACTIVIDADES -->
        
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.DiccionarioHipHop.NoActionBar"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity 
            android:name=".MainActivity" 
            android:exported="false" 
            android:theme="@style/Theme.DiccionarioHipHop.NoActionBar"
            android:screenOrientation="portrait" />
            
        <activity 
            android:name=".RegisterActivity" 
            android:exported="false" 
            android:theme="@style/Theme.DiccionarioHipHop.NoActionBar"
            android:screenOrientation="portrait" />
            
        <activity 
            android:name=".VerifyAccountActivity" 
            android:exported="false" 
            android:theme="@style/Theme.DiccionarioHipHop.NoActionBar"
            android:screenOrientation="portrait" />
            
        <activity 
            android:name=".ForgotPasswordActivity" 
            android:exported="false" 
            android:theme="@style/Theme.DiccionarioHipHop.NoActionBar"
            android:screenOrientation="portrait" />
            
        <activity 
            android:name=".ResetPasswordActivity" 
            android:exported="false" 
            android:theme="@style/Theme.DiccionarioHipHop.NoActionBar"
            android:screenOrientation="portrait" />
            
        <!-- 🔥 PROTEGIDAS: Estas NO se reinician para no cortar la música ni la búsqueda -->
        <activity 
            android:name=".SongSelectionActivity" 
            android:exported="false" 
            android:theme="@style/Theme.DiccionarioHipHop.NoActionBar"
            android:configChanges="uiMode|colorMode" 
            android:screenOrientation="portrait" />
            
        <activity 
            android:name=".SongLearningActivity" 
            android:exported="false" 
            android:theme="@style/Theme.DiccionarioHipHop.NoActionBar"
            android:configChanges="uiMode|colorMode"
            android:screenOrientation="portrait" />
            
        <!-- 🟢 INSTANTÁNEAS: Estas SÍ se reinician para cambiar color al momento -->
        <activity 
            android:name=".DictionaryActivity" 
            android:exported="false" 
            android:theme="@style/Theme.DiccionarioHipHop.NoActionBar"
            android:screenOrientation="portrait" />
            
        <activity 
            android:name=".FlashcardsActivity" 
            android:exported="false" 
            android:theme="@style/Theme.DiccionarioHipHop.NoActionBar"
            android:screenOrientation="portrait" />

        <activity android:name=".ProfileActivity" 
            android:exported="false" 
            android:theme="@style/Theme.DiccionarioHipHop.NoActionBar"
            android:screenOrientation="portrait" />
            
        <activity 
            android:name=".EditProfileActivity" 
            android:exported="false" 
            android:theme="@style/Theme.DiccionarioHipHop.NoActionBar"
            android:screenOrientation="portrait" />
            
        <activity 
            android:name=".SettingsActivity" 
            android:exported="false" 
            android:theme="@style/Theme.DiccionarioHipHop.NoActionBar"
            android:screenOrientation="portrait" />

        <!-- 🔥 FIX IMPORTANTE: Declarar la actividad de CanHub explícitamente -->
        <!-- Usamos un tema AppCompat estándar para asegurar que los botones se pinten -->
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar" />
        
    </application>

</manifest>